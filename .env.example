# =====================================================
# RADAR RIDER MADRID
# Variables de entorno de ejemplo
# =====================================================

# Token del Bot de Telegram
TOKEN=TU_TOKEN_AQUI

# ID del grupo oficial de Telegram
GROUP_ID=TU_GROUP_ID

# Tu user_id de Telegram. Restringe /chatid a ti: si se deja vacio,
# /chatid no responde a nadie.
ADMIN_USER_ID=TU_USER_ID

# =====================================================
# WhatsApp (OpenWA, gateway self-hosted) - opcional
# =====================================================
# Si WHATSAPP_ALERT_PHONE se deja vacio, el envio por WhatsApp se omite
# y el bot sigue funcionando igual (solo Telegram).

OPENWA_BASE_URL=http://TU_IP_O_HOST_OPENWA:2785
OPENWA_API_KEY=TU_CLAVE_OPERADOR_OPENWA
OPENWA_SESSION_ID=TU_UUID_DE_SESION
WHATSAPP_ALERT_PHONE=

# WHATSAPP_GROUP_ID (formato "1234567890-1234567890@g.us"): si se
# define, el envio usa el grupo en vez de WHATSAPP_ALERT_PHONE.
WHATSAPP_GROUP_ID=

# WHATSAPP_GROUP_ID_TEST: grupo de pruebas, usado solo si
# WHATSAPP_GROUP_ID esta vacio. Util para validar el formato de las
# alertas antes de activar el grupo real.
WHATSAPP_GROUP_ID_TEST=

# =====================================================
# Base de datos - opcional
# =====================================================
# Carpeta donde vive el .db. En Docker, mapea esto a un volumen
# persistente (ej. DB_DIR=/app/data con -v ./data:/app/data) para
# que los datos sobrevivan a un rebuild de la imagen. Si se deja
# vacio, se usa la carpeta database/ del propio proyecto.
DB_DIR=
